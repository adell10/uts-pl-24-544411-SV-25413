# Salin jadi .env:   cp .env.example .env   (file .env TIDAK ikut di-commit)
# Dipakai oleh docker-compose.yml

# Buat dengan:  cd backend && php artisan key:generate --show
APP_KEY=

DB_DATABASE=cafehopper
DB_USERNAME=cafehopper
DB_PASSWORD=ganti_dengan_password_kamu
DB_ROOT_PASSWORD=ganti_dengan_password_root

# true = isi akun demo + contoh kafe saat backend start (aman dijalankan berulang)
SEED_ON_START=true