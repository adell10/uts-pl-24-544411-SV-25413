# Alamat API Laravel. Salin jadi .env untuk development lokal.
# - Lokal (php artisan serve): http://localhost:8000/api
# - Docker Compose: tidak perlu diisi, otomatis "/api" (diteruskan Nginx ke service "backend")
# Catatan: nilai VITE_ ikut masuk ke JavaScript di browser, jadi JANGAN isi rahasia di sini.
VITE_API_URL=http://localhost:8000/api